# Copie este arquivo para .env e preencha com os valores reais. Nunca commite o .env.

# Connect to Postgres via o pooler em modo transação (IPv4-only) — usada em runtime pela API.
DATABASE_URL="postgresql://usuario:senha@host:5432/postgres?pgbouncer=true"

# Connect to Postgres via o pooler em modo sessão — usada só pelo Prisma CLI (migrate/generate).
DIRECT_URL="postgresql://usuario:senha@host:5432/postgres"

# Chaves do projeto Supabase (Dashboard > Project Settings > API). Hoje não são lidas por
# nenhum código em src/ — reservadas para quando Storage/Auth do Supabase forem integrados
# (ex: upload de imagem de produto, ver Produto.imagemUrl no schema.prisma).
SUPABASE_URL="https://SEU_PROJETO.supabase.co"
SUPABASE_ANON_KEY=""

# Segredo usado para assinar os JWTs (ver Back/src/conf/env.ts) — precisa ter no mínimo 32
# caracteres. Gere um valor aleatório, ex: `openssl rand -base64 32`. Nunca reaproveite o
# mesmo valor entre ambientes (dev/staging/produção).
SECRET_KEY=""

# Porta da API. Opcional — padrão 3000 se omitida (ver Back/src/server.ts).
PORT=3000

# Opcional — padrão "development" se omitida.
NODE_ENV=development

# Origens permitidas pelo CORS, separadas por vírgula. Opcional — sem essa variável, o
# padrão em dev é http://localhost:5173,http://localhost:5174 (ver Back/src/server.ts).
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"

# Sobrescreve o teto de tentativas de autenticação por hora (padrão: 10, ver server.ts).
# Existe só para a suíte e2e (Front/playwright.config.ts) rodar sem esbarrar no rate
# limit — não defina isso fora desse cenário.
AUTH_RATE_LIMIT_MAX=

# Usadas pelo fluxo de "esqueci minha senha" (ver Back/src/services/email.ts) para enviar
# o e-mail de redefinição via Resend (https://resend.com). Obrigatórias em produção — em
# desenvolvimento, se deixadas em branco, o e-mail é apenas logado no console.
RESEND_API_KEY=
# Precisa ser um remetente verificado no seu domínio Resend, ex: "Controle de Estoque <naoresponda@seudominio.com>".
RESEND_FROM_EMAIL=

# URL pública do front, usada para montar o link de redefinição de senha enviado por
# e-mail. Padrão em dev: http://localhost:5173.
FRONTEND_URL="http://localhost:5173"
